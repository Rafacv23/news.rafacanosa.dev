---
import Icon from "./Icon.astro"
---

<header class="container header">
  <a href="/" class="title">blog.rafacanosa.dev</a>
  <nav>
    <a href="/articulos" class="btn outline">Artículos</a>
    <button type="button" class="btn outline" data-search-open aria-label="Buscar artículos" title="Buscar (⌘K)">
      <Icon name="search" size={20} />
    </button>
    <button type="button" class="btn outline" id="theme-toggle" aria-label="Cambiar tema claro/oscuro">
      <Icon name="sun" size={20} class="sun" />
      <Icon name="moon" size={20} class="moon" />
    </button>
  </nav>
</header>

<script>
  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const root = document.documentElement
    const next = root.dataset.theme === "dark" ? "light" : "dark"
    root.dataset.theme = next
    localStorage.setItem("theme", next)
  })
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    margin-bottom: 2rem;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 300;
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  :global([data-theme="dark"] .sun),
  :global([data-theme="light"] .moon) {
    display: none;
  }
  @media (max-width: 600px) {
    .title {
      font-size: 1rem;
    }
    nav a {
      display: none;
    }
  }
</style>
