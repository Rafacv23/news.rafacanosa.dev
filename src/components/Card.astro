---
import type { CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import Icon from "./Icon.astro"

interface Props {
  post: CollectionEntry<"articulos">
  variant?: "row" | "featured" | "compact"
}
const { post, variant = "row" } = Astro.props
const { title, description, cover, coverAlt } = post.data
---

<a href={`/${post.id}`} class:list={["card", variant]}>
  {
    variant !== "row" && (
      <Image
        src={cover}
        alt={coverAlt}
        widths={variant === "featured" ? [720, 1440] : [300, 600]}
        sizes={variant === "featured" ? "(max-width: 720px) 100vw, 720px" : "280px"}
        loading={variant === "featured" ? "eager" : "lazy"}
      />
    )
  }
  <h3>{title} <Icon name="arrow-up-right" /></h3>
  <p>{description}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 0.5rem;
    padding: 1rem;
    transition: all 0.1s ease-in-out;
    &:hover {
      background-color: var(--card);
    }
    &:active {
      transform: scale(0.98);
    }
  }
  img {
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }
  h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  p {
    color: var(--secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row p {
    max-width: 50ch;
  }
  .compact {
    height: 100%;
    padding: 0.75rem;
    & img {
      aspect-ratio: 16 / 9;
      margin-bottom: 0.75rem;
    }
    & h3 {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }
    & p {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      font-size: 0.9rem;
    }
  }
</style>
