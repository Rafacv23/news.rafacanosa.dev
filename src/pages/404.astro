---
import Base from "../layouts/Base.astro"
---

<Base title="Página no encontrada" noindex>
  <main class="container">
    <h1 class="section-title">404 · Aquí no hay nada</h1>
    <p>Puede que el artículo haya cambiado de dirección. Prueba a buscarlo:</p>
    <p style="margin-top:2rem;display:flex;gap:.5rem">
      <button class="btn" data-search-open>Buscar</button>
      <a href="/" class="btn outline">Ir al inicio</a>
    </p>
  </main>
</Base>
